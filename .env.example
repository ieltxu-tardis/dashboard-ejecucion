# Copy to .env and fill real values before starting services.

# PostgreSQL
POSTGRES_DB=openclaw
POSTGRES_USER=openclaw
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional app-side references
DATABASE_URL=postgresql://openclaw:CHANGE_ME_STRONG_PASSWORD@postgres:5432/openclaw
REDIS_URL=redis://redis:6379

# Governance / approvals
APPROVAL_TTL_SECONDS=900
APPROVALS_ADMIN_ACTOR=admin-local
MODULES_ENABLED=idealab,timelab
FINANCE_DEFAULT_CURRENCY=USD
FINANCE_IMPORT_MAX_ROWS=1000
